---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks · Vinta" description="We received your message.">
  <section class="section">
    <div class="container" style="max-width:720px;display:flex;flex-direction:column;gap:24px">
      <p class="eyebrow">Message received</p>
      <h1 class="h2">Thanks. A senior engineer will reply within one business day.</h1>
      <p class="lede">Meanwhile, browse more healthcare work or see how Building Blocks help teams start ahead.</p>
      <p><a class="btn btn--primary" href="/work">Back to the work</a></p>
    </div>
  </section>
</Base>
