  layers: '<path d="m10 3 7 3.5-7 3.5-7-3.5L10 3Z"/><path d="m3 10 7 3.5 7-3.5"/><path d="m3 13.5 7 3.5 7-3.5"/>',
  grid: '<rect x="3.5" y="3.5" width="5" height="5" rx="1"/><rect x="11.5" y="3.5" width="5" height="5" rx="1"/><rect x="3.5" y="11.5" width="5" height="5" rx="1"/><rect x="11.5" y="11.5" width="5" height="5" rx="1"/>',
  route: '<circle cx="5" cy="15" r="2"/><circle cx="15" cy="5" r="2"/><path d="M7 15h5.5a2.5 2.5 0 0 0 0-5h-5a2.5 2.5 0 0 1 0-5H13"/>',
  check: '<path d="m4.5 10.5 3.5 3.5 7.5-8"/>',
  'arrow-right': '<path d="M4 10h12"/><path d="m11 5 5 5-5 5"/>',
  'arrow-left': '<path d="M16 10H4"/><path d="m9 5-5 5 5 5"/>',
  'arrow-up-right': '<path d="M6 14 14 6"/><path d="M7 6h7v7"/>',
  chat: '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h9A1.5 1.5 0 0 1 16 5.5v6a1.5 1.5 0 0 1-1.5 1.5H9l-3.5 3v-3h0A1.5 1.5 0 0 1 4 11.5v-6Z"/>',
  'chevron-down': '<path d="m5.5 8 4.5 4.5L14.5 8"/>',
  mail: '<rect x="3" y="5" width="14" height="10" rx="1.5"/><path d="m3.5 6 6.5 5 6.5-5"/>',
  play: '<path d="M7 5.5v9l7.5-4.5L7 5.5Z" fill="currentColor"/>',
  alert: '<circle cx="10" cy="10" r="7"/><path d="M10 6.5v4"/><path d="M10 13.3v.2"/>',
  menu: '<path d="M4 6h12M4 10h12M4 14h12"/>',
  close: '<path d="m5 5 10 10M15 5 5 15"/>',
};
const body = paths[name] ?? '';
---
