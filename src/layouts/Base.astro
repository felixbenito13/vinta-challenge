---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; preload?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; jsonld?: object[]; noindex?: boolean }
const { title, description, preload, image = '/img/og-vinta-healthcare-work.jpg', imageAlt = 'Editorial illustration from Vinta’s healthcare work', type = 'website', jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Vinta Software" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0050ff" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Geist-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <aside aria-label="Quick contact"><a href="#contact" class="floating btn btn--primary" aria-label="Let’s talk: go to the contact form">
      <svg class="icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h9A1.5 1.5 0 0 1 16 5.5v6a1.5 1.5 0 0 1-1.5 1.5H9l-3.5 3v-3A1.5 1.5 0 0 1 4 11.5v-6Z"/></svg>
      <span>Let’s talk</span>
    </a></aside>
    <style>
      .floating { position: fixed; right: 24px; bottom: 24px; z-index: 40; height: 56px; border-radius: var(--radius-full); padding: 0 24px; box-shadow: var(--shadow-brand-lift); }
      @media (max-width: 600px) { .floating { right: 16px; bottom: 16px; width: 56px; padding: 0; justify-content: center; } .floating span { display: none; } }
    </style>
  </body>
</html>
